# Jarvis Voice Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# REQUIRED - At least one LLM provider
# =============================================================================

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (alternative LLM + TTS + STT)
# OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# TEXT-TO-SPEECH
# =============================================================================

# ElevenLabs (best quality voices)
# Get API key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# =============================================================================
# WAKE WORD DETECTION
# =============================================================================

# Picovoice Porcupine (high accuracy wake word)
# Get FREE API key at: https://picovoice.ai/
PORCUPINE_ACCESS_KEY=your-porcupine-access-key-here

# =============================================================================
# OPTIONAL - Smart Home Integration
# =============================================================================

# Philips Hue (direct bridge control via API v2 / CLIP v2)
# Press the bridge button, then create an application key via:
#   curl -X POST https://<bridge-ip>/api -d '{"devicetype":"friday#assistant","generateclientkey":true}' -k
# Use the "username" field from the response as HUE_APPLICATION_KEY
# HUE_BRIDGE_IP=10.0.0.242
# HUE_APPLICATION_KEY=your-hue-application-key

# Home Assistant
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token

# =============================================================================
# OPTIONAL - Reservations agent (docs/reservations-agent-spec.md)
# =============================================================================

# Master switch for the reservations workflow
# RESERVATIONS_ENABLED=true

# Business discovery — Yelp Fusion API (https://www.yelp.com/developers)
# YELP_API_KEY=your-yelp-fusion-api-key
# TAVILY_API_KEY is shared with internet search above and reused for discovery.

# Phone channel — Bland.ai autonomous calls (https://www.bland.ai/)
# RESERVATION_PHONE_PROVIDER=bland          # bland | dial_and_bridge | off
# BLAND_API_KEY=your-bland-api-key
# RESERVATION_CALL_RETRIES=3                # per open window, on no-answer/busy
# RESERVATION_CALL_DEADLINE_DAYS=7

# Payment — Privacy.com single-use cards, HARD-capped at $10
# (https://developers.privacy.com/) — limit can only be lowered, never raised
# PRIVACY_API_KEY=your-privacy-api-key
# RESERVATION_CARD_LIMIT_USD=10

# Email channel (reservation-by-email) — sends via SMTP, watches the reply
# thread via IMAP (only that thread; never the broader inbox)
# RESERVATION_EMAIL_PROVIDER=smtp           # smtp | off
# RESERVATION_EMAIL_FROM=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-password
# IMAP_HOST=imap.example.com
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-imap-password
# RESERVATION_EMAIL_DEADLINE_DAYS=5

# Signal notifications when Friday isn't listening (signal-cli-rest-api)
# SIGNAL_CLI_URL=http://localhost:8080
# SIGNAL_FROM_NUMBER=+15551230000
# SIGNAL_TO_NUMBER=+15551230000

# Calendar + user defaults for slot-filling
# RESERVATION_CALENDAR_ID=primary
# RESERVATION_USER_PHONE=+15551230000
# RESERVATION_USER_EMAIL=you@example.com
# RESERVATION_GUEST_NAME=Your Name

# Browser channels (OpenTable/Resy/Yelp/generic web)
# RESERVATION_BROWSER_DIR=~/.friday/browser # persistent logged-in profiles
# RESERVATION_BROWSER_CHANNEL=chrome        # use your installed Chrome/Edge instead
#                                           # of bundled Chromium (fewer bot false-positives)
# RESERVATION_WATCH_INTERVAL_SECONDS=1800   # wait-and-book re-check interval
# RESERVATION_WATCH_DEADLINE_DAYS=3

# LLM refinement (slot extraction + discovery classification); falls back to
# heuristics when unset. Uses ANTHROPIC_API_KEY above.
# RESERVATION_LLM_MODEL=claude-haiku-4-5-20251001

# Safety
# RESERVATION_KILL_SWITCH=                  # set to anything → research-only mode
# RESERVATION_ALLOW_SANDBOX_BOTS=false      # Docker GitHub-bot fallback (off by default)

# =============================================================================
# OPTIONAL - Alternative STT Providers
# =============================================================================

# Deepgram (fast cloud STT)
# DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Vosk (local STT - download model separately)
# VOSK_MODEL_PATH=/path/to/vosk-model
