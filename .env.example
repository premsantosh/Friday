# Jarvis Voice Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# REQUIRED - At least one LLM provider
# =============================================================================

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (alternative LLM + TTS + STT)
# OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# TEXT-TO-SPEECH
# =============================================================================

# ElevenLabs (best quality voices)
# Get API key at: https://elevenlabs.io/
# BOTH vars are required to enable ElevenLabs TTS — with either missing, Friday
# falls back to the system voice. Find the voice ID in the ElevenLabs dashboard
# (Voices → pick a voice → copy Voice ID), or list them via:
#   curl -s -H "xi-api-key: $ELEVENLABS_API_KEY" \
#     https://api.elevenlabs.io/v1/voices | jq '.voices[] | {name, voice_id}'
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here

# =============================================================================
# WAKE WORD DETECTION
# =============================================================================

# Picovoice Porcupine (high accuracy wake word)
# Get FREE API key at: https://picovoice.ai/
PORCUPINE_ACCESS_KEY=your-porcupine-access-key-here

# =============================================================================
# OPTIONAL - Smart Home Integration
# =============================================================================

# Philips Hue (direct bridge control via API v2 / CLIP v2)
# Press the bridge button, then create an application key via:
#   curl -X POST https://<bridge-ip>/api -d '{"devicetype":"friday#assistant","generateclientkey":true}' -k
# Use the "username" field from the response as HUE_APPLICATION_KEY
# HUE_BRIDGE_IP=10.0.0.242
# HUE_APPLICATION_KEY=your-hue-application-key

# Home Assistant
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token

# =============================================================================
# OPTIONAL - Reservations agent (docs/reservations-agent-spec.md)
# =============================================================================

# Master switch for the reservations workflow
# RESERVATIONS_ENABLED=true

# Business discovery — set ONE of these. Google Places is preferred when both
# are present (Google Maps Platform needs a billing account but its monthly
# free tier covers personal use; Yelp Fusion is now a paid plan). Google also
# returns opening hours, which enable off-hours phone-call deferral.
#   Google: https://console.cloud.google.com → enable "Places API (New)"
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# YELP_API_KEY=your-yelp-fusion-api-key
# TAVILY_API_KEY is shared with internet search above and reused for discovery.

# Phone channel — Bland.ai autonomous calls (https://www.bland.ai/)
# RESERVATION_PHONE_PROVIDER=bland          # bland | dial_and_bridge | off
# BLAND_API_KEY=your-bland-api-key
# RESERVATION_CALL_RETRIES=3                # per open window, on no-answer/busy
# RESERVATION_CALL_DEADLINE_DAYS=7

# Payment — single-use cards, HARD-capped at $10 (limit can only be lowered,
# never raised). Two providers; RESERVATION_CARD_PROVIDER picks one explicitly
# (privacy | manual | off), otherwise privacy wins when its key is set.
#
# (a) Privacy.com API (https://developers.privacy.com/ — paid API plan):
# PRIVACY_API_KEY=your-privacy-api-key
#
# (b) Manual: mint a SINGLE-USE card yourself in the Privacy.com app (set its
#     limit to $10 or less there too) and paste it here. NEVER a real card —
#     this file's card declines safely on reuse, a real one doesn't. Replace
#     it after it's spent. Card data never leaves .env except into the booking
#     form at commit time; it is never logged, persisted, or sent to any LLM.
# RESERVATION_CARD_PROVIDER=manual
# RESERVATION_CARD_NUMBER=4111111111111111
# RESERVATION_CARD_CVV=123
# RESERVATION_CARD_EXP_MONTH=12
# RESERVATION_CARD_EXP_YEAR=2030
#
# RESERVATION_CARD_LIMIT_USD=10
# Billing ZIP for venues that require a card on file (e.g. OpenTable no-show
# guarantees). Privacy.com single-use cards ignore AVS, so any valid ZIP works;
# set it to your card's real billing ZIP to be safe.
# RESERVATION_CARD_ZIP=94115

# Email channel (reservation-by-email) — sends via SMTP, watches the reply
# thread via IMAP (only that thread; never the broader inbox)
# RESERVATION_EMAIL_PROVIDER=smtp           # smtp | off
# RESERVATION_EMAIL_FROM=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-password
# IMAP_HOST=imap.example.com
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-imap-password
# RESERVATION_EMAIL_DEADLINE_DAYS=5

# -----------------------------------------------------------------------------
# Telegram two-way chat + notifications (easiest free option — no phone/SMS/captcha).
# Setup: in Telegram, message @BotFather → /newbot → copy the token below.
# Once TELEGRAM_BOT_TOKEN is set, the listener turns on automatically:
# `python main.py` listens on voice + text + Telegram together. (`--telegram`
# runs Telegram-only and headless, e.g. on a server with no mic/terminal.)
# Inbound is restricted to TELEGRAM_ALLOWED_CHAT_IDS (comma-separated numeric
# chat IDs). Leave it unset on first run, message your bot, and it replies with
# the chat ID to add here. Until it's set, messages are answered with that hint
# but NOT acted on (fail closed).
# Reservation/async notifications go to TELEGRAM_NOTIFY_CHAT_ID, or the first
# TELEGRAM_ALLOWED_CHAT_IDS entry if that's unset.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# TELEGRAM_NOTIFY_CHAT_ID=123456789
# TELEGRAM_LONG_POLL_SECONDS=20

# -----------------------------------------------------------------------------
# Voice PE satellites — Home Assistant Voice Preview Edition pucks as room mics.
# No Home Assistant server: Friday talks to each device directly over the
# ESPHome native API. The puck hears the wake word and streams mic audio;
# Friday transcribes, thinks, and speaks the reply on this Mac's speakers.
# One-time setup per device: provision Wi-Fi at https://esphome.github.io/esphome-web/
# (USB-C or the device's setup hotspot), find its IP (router DHCP list, or
# `ping voice-pe-xxxxxx.local`), then give it a DHCP reservation or use the
# .local name below. Setting VOICE_PE_DEVICES enables the channel:
# `python main.py` then listens on voice + text + Telegram + satellites.
# VOICE_PE_DEVICES=kitchen=192.168.1.50,office=voice-pe-office.local:6053
#   name=host[:port], comma-separated. The name becomes the room's session id.
# A fresh (never HA-adopted) device needs no key. If a device was ever adopted
# by Home Assistant, reuse its stored API encryption key here — or factory-reset.
# VOICE_PE_NOISE_PSK=              # API encryption key for all devices (optional)
# VOICE_PE_NOISE_PSK_KITCHEN=      # per-device override (device name uppercased)
# VOICE_PE_WAKE_WORD=Hey Jarvis    # enforced on the device on every (re)connect
# VOICE_PE_SILENCE_SECONDS=1.2     # end-of-speech silence gate
# VOICE_PE_MAX_UTTERANCE_SECONDS=15

# Calendar + user defaults for slot-filling
# Service-account JSON for Google Calendar event creation:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-calendar-sa.json
# RESERVATION_TIMEZONE=America/Los_Angeles
# RESERVATION_CALENDAR_ID=primary
# These three seed the durable profile (see below) on first use.
# RESERVATION_USER_PHONE=+15551230000
# RESERVATION_USER_EMAIL=you@example.com
# RESERVATION_GUEST_NAME=Your Full Name

# Durable facts about you (name, email, phone, date of birth, insurance...),
# used to fill any business's booking or contact form. Stored in a `profile`
# table in ~/.friday/memory.db, chmod 0600. Manage it with:
#   python -m core.profile list | fields | show -c <persona>
#   python -m core.profile set [-c <persona>] <key> <value> | delete <key>
#   python -m core.profile which "<business or service>"   # which persona?
# Personas: 'formal' (medical/legal/financial/government — your full legal
# name), 'casual' (restaurants, salons, spas — your everyday name), and
# 'default' for facts shared by both, like your email. A form asking for a
# date of birth or insurance details is treated as formal whatever it's called.
# The field-mapping LLM only ever sees the KEYS, never the values or the persona.
# FRIDAY_PROFILE_DB=~/.friday/memory.db
# Multi-page forms: how many "next" steps to walk before giving up.
# RESERVATION_FORM_MAX_STEPS=3

# Browser channels (OpenTable/Resy/Yelp/generic web)
# RESERVATION_BROWSER_DIR=~/.friday/browser # persistent logged-in profiles
# RESERVATION_BROWSER_CHANNEL=chrome        # use your installed Chrome/Edge instead
#                                           # of bundled Chromium (fewer bot false-positives)
# RESERVATION_WATCH_INTERVAL_SECONDS=1800   # wait-and-book re-check interval
# RESERVATION_WATCH_DEADLINE_DAYS=3

# Reservation sniping: when you state a release policy ("opens 30 days in advance
# at 10am ET"), Friday parks the booking and races it the instant the window
# opens. Requires the app to be running at fire time (not in --chat mode).
# RESERVATION_SNIPE_ENABLED=true
# RESERVATION_SNIPE_LEAD_SECONDS=5          # wake this far before the release instant
# RESERVATION_SNIPE_RETRY_BUDGET_S=90       # keep retrying for this long after it opens
# RESERVATION_SNIPE_RETRY_GAP_SECONDS=8     # pause between attempts
# RESERVATION_SNIPE_MAX_ATTEMPTS=6
# Auto-detect the release policy (incl. a Reddit search) when you don't state one:
# RESERVATION_SNIPE_AUTODETECT=true
# RESERVATION_SNIPE_AUTODETECT_MIN_DAYS=14  # only look it up for dates this far out
# RESERVATION_SNIPE_MIN_CONFIDENCE=0.4      # ignore low-confidence guesses

# Standing availability watch on TableCheck venues (M8/M9): "Watch BenFiddich
# for September 5th, 9th or 10th for 4" messages you on Telegram with a booking
# deep link the moment a matching day opens; add "and book it" and Friday books
# the first matching table itself (earliest listed date, earliest seating),
# using the durable profile's name/email/phone and the single-use card for the
# venue's card-on-file cancel policy. When the calendar isn't published yet it
# researches the venue's release time (web + Reddit) and bursts around the
# predicted drop; `python -m workflows.reservations.watch_cli add --release …`
# pins a known drop instant instead. Requires the app to be running (not --chat).
# TABLECHECK_WATCH_INTERVAL_SECONDS=300     # normal re-check cadence (min 60)
# TABLECHECK_WATCH_IDLE_INTERVAL_SECONDS=3600 # cadence while the calendar is closed
# TABLECHECK_WATCH_BURST_SECONDS=60         # cadence around a predicted drop (min 20)
# TABLECHECK_BURST_TAIL_SECONDS=3600        # keep bursting this long after the drop
# TABLECHECK_BURST_INNER_SECONDS=240        # one tick keeps bursting inside itself this long
# TABLECHECK_UNIT_SPACING_SECONDS=5         # gap between requests to one venue
# TABLECHECK_BOOK_MAX_ATTEMPTS=40           # auto-book attempts per watch before it gives up
# TABLECHECK_BOOK_COOLDOWN_SECONDS=120      # rest a date this long after a failed attempt
# TABLECHECK_CHECKOUT_WAIT_SECONDS=90       # how long to poll a "pending" checkout
# RESERVATION_PHONE_COUNTRY_CODE=1          # for profile phones stored without +country
# TABLECHECK_API_BASE=https://production-booking.tablecheck.com/v2  # the widget's API

# LLM refinement (slot extraction + discovery classification); falls back to
# heuristics when unset. Uses ANTHROPIC_API_KEY above.
# RESERVATION_LLM_MODEL=claude-haiku-4-5-20251001

# Safety
# RESERVATION_KILL_SWITCH=                  # set to anything → research-only mode
#   (re-checked by the harness gate at the moment each action fires, so a flip
#    mid-flight blocks pending calls/emails/bookings too)
# RESERVATION_ALLOW_SANDBOX_BOTS=false      # Docker GitHub-bot fallback (off by default)
# FRIDAY_AUDIT_DB=~/.friday/audit.db        # append-only audit log of gated actions

# =============================================================================
# OPTIONAL - Alternative STT Providers
# =============================================================================

# Deepgram (fast cloud STT)
# DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Vosk (local STT - download model separately)
# VOSK_MODEL_PATH=/path/to/vosk-model
